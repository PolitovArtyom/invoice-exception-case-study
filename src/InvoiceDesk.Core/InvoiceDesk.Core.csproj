<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RuntimeIdentifiers>osx-arm64;osx-x64;linux-x64;linux-arm64;win-x64</RuntimeIdentifiers>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="JsonSchema.Net" />
    <InternalsVisibleTo Include="InvoiceDesk.Tests" />
    <EmbeddedResource
      Include="../../dataset/schemas/*.schema.json"
      LogicalName="Schemas.%(Filename)%(Extension)"
    />
  </ItemGroup>
</Project>
